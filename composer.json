{
    "name": "b13/phone-number",
    "description": "Fluid ViewHelper for formatting phone numbers using libphonenumber",
    "type": "typo3-cms-extension",
    "homepage": "https://b13.com",
    "license": ["GPL-2.0-or-later"],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "giggsey/libphonenumber-for-php-lite": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "B13\\PhoneNumber\\": "Classes/"
        }
    },
    "replace": {
        "phone_number": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "phone_number"
        }
    }
}
